{
  "name": "indie-deck",
  "version": "0.1.1",
  "private": true,
  "description": "Unified launcher for Unity and other indie games: engine classification, per-engine translator auto-install with version compatibility management, and mod management.",
  "author": "tjwlstj",
  "homepage": "https://github.com/tjwlstj/indie-deck",
  "repository": {
    "type": "git",
    "url": "https://github.com/tjwlstj/indie-deck.git"
  },
  "main": "packages/desktop/dist/main.js",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/desktop"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --dry 2>&1 || tsc --build",
    "test": "node --test --experimental-strip-types packages/core/test/*.test.ts",
    "registry:check": "node --experimental-strip-types packages/cli/src/index.ts registry check",
    "verify": "npm run build && npm test && npm run registry:check",
    "indiedeck": "node --experimental-strip-types packages/cli/src/index.ts",
    "desktop": "npm run build && electron packages/desktop",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run verify && electron-builder --win nsis portable --x64 --publish never",
    "package:check": "node scripts/check-package.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@indiedeck/core": "0.1.1",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^22.10.2",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.1",
    "typescript": "^5.7.2"
  }
}
