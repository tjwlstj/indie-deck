{
  "manifest_version": 3,
  "name": "IndieDeck Browser Companion",
  "version": "0.1.11",
  "description": "선택한 공식 게임 상품 정보를 IndieDeck 연결 파일로 저장합니다. 로그인 정보나 다운로드 주소는 보내지 않습니다.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "IndieDeck 상품 연결",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-companion@indiedeck.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  }
}
