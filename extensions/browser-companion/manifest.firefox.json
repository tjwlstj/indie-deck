{
  "manifest_version": 3,
  "name": "IndieDeck Browser Companion",
  "version": "0.2.0",
  "description": "공식 상품 연결과 선택적 대표 이미지 가져오기를 지원합니다. 허용한 사이트에서 큰 자동 패널을 열고 숨길 수 있습니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "IndieDeck 상품 연결",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-companion@indiedeck.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'none'; base-uri 'none'"
  },
  "optional_host_permissions": [
    "https://store.steampowered.com/*",
    "https://store.epicgames.com/*",
    "https://www.gog.com/*",
    "https://gog.com/*",
    "https://*.itch.io/*",
    "https://booth.pm/*",
    "https://*.booth.pm/*",
    "https://www.dlsite.com/*",
    "https://dlsite.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-panel.js",
        "popup-controller.js",
        "store-link.js",
        "artwork.js",
        "auto-panel-settings.js",
        "browser-api.js"
      ],
      "matches": [
        "https://store.steampowered.com/*",
        "https://store.epicgames.com/*",
        "https://www.gog.com/*",
        "https://gog.com/*",
        "https://*.itch.io/*",
        "https://booth.pm/*",
        "https://*.booth.pm/*",
        "https://www.dlsite.com/*",
        "https://dlsite.com/*"
      ]
    }
  ]
}
