{
  "manifest_version": 3,
  "name": "IndieDeck Browser Companion",
  "version": "0.1.18",
  "description": "선택한 공식 게임 상품 정보를 IndieDeck 연결 파일로 저장합니다. 로그인 정보나 다운로드 주소는 보내지 않습니다.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "IndieDeck 상품 연결",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'none'; base-uri 'none'"
  }
}
