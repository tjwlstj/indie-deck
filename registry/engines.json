{
  "$schema": "./schema/engines.schema.json",
  "schemaVersion": 1,
  "updated": "2026-08-21",
  "notes": "Detection rules are declarative. Each matching rule contributes its `score`; an engine is a candidate when its total >= minScore. Highest total wins, ties broken by `priority`. A rule with `capture` stores its match under that name so later rules of the same engine can reference it as $name.",
  "engines": [
    {
      "id": "unity",
      "name": "Unity",
      "family": "unity",
      "priority": 90,
      "minScore": 60,
      "rules": [
        {
          "kind": "file",
          "value": "UnityPlayer.dll",
          "score": 60,
          "note": "Unity 5.4+ standalone player runtime"
        },
        {
          "kind": "dirSuffix",
          "value": "_Data",
          "score": 45,
          "capture": "dataDir",
          "note": "<GameName>_Data payload folder, present in every Windows Unity build"
        },
        {
          "kind": "fileUnder",
          "dir": "$dataDir",
          "value": "globalgamemanagers",
          "score": 25
        },
        {
          "kind": "fileUnder",
          "dir": "$dataDir",
          "value": "data.unity3d",
          "score": 25,
          "note": "Unity 2019+ single-bundle builds ship this instead of globalgamemanagers"
        },
        {
          "kind": "dir",
          "value": "MonoBleedingEdge",
          "score": 15,
          "note": "Mono scripting backend runtime"
        },
        {
          "kind": "file",
          "value": "GameAssembly.dll",
          "score": 15,
          "note": "IL2CPP scripting backend"
        },
        {
          "kind": "fileAny",
          "value": [
            "UnityCrashHandler64.exe",
            "UnityCrashHandler32.exe"
          ],
          "score": 10
        }
      ],
      "probes": [
        "unityBackend",
        "unityVersion",
        "peArch"
      ],
      "loaders": [
        "bepinex5",
        "bepinex6-mono",
        "bepinex6-il2cpp",
        "melonloader",
        "unity-mod-manager",
        "reipatcher"
      ],
      "translators": [
        "xunity-autotranslator",
        "mort",
        "lunatranslator"
      ]
    },
