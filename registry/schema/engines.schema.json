{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tjwlstj/indie-deck/registry/schema/engines.schema.json",
  "title": "IndieDeck engine detection registry",
  "type": "object",
  "required": ["schemaVersion", "engines"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updated": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "engines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/engine" } }
  },
  "$defs": {
    "engine": {
      "type": "object",
      "required": ["id", "name", "family", "priority", "minScore", "rules", "probes", "loaders", "translators"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "displayName": { "type": "string", "description": "Shown to users when it differs from the ASCII-safe `name`." },
        "family": { "type": "string" },
        "priority": { "type": "integer", "description": "Tie-break when two engines score equally." },
        "minScore": { "type": "integer", "minimum": 1 },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
        "probes": { "type": "array", "items": { "type": "string" } },
        "loaders": { "type": "array", "items": { "type": "string" } },
        "translators": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rule": {
      "type": "object",
      "required": ["kind", "value", "score"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "file",
            "fileAny",
            "fileGlob",
            "fileUnder",
            "dir",
            "dirAny",
            "dirGlob",
            "dirSuffix",
            "extRoot",
            "extUnder",
            "exeSiblingExt",
            "exeSiblingSuffix"
          ]
        },
        "value": {
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        },
        "dir": { "type": "string", "description": "Base directory; may reference a capture as $name." },
        "score": { "type": "integer" },
        "capture": { "type": "string", "description": "Stores the matched path for later rules of the same engine." },
        "recursive": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
