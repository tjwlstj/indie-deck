    {
      "id": "mort",
      "name": "MORT",
      "kind": "ocr-overlay",
      "homepage": "https://github.com/killkimno/MORT",
      "repo": "killkimno/MORT",
      "license": "MIT",
      "engines": [
        "*"
      ],
      "summary": "Korean-first real-time OCR screen translator. Engine-agnostic: it reads pixels, so it works where in-process hooks cannot (IL2CPP holdouts, GameMaker, Flash, emulators).",
      "runsOutOfProcess": true,
      "variants": [
        {
          "id": "standalone",
          "name": "Standalone",
          "assetTemplate": "MORT.{version}v.-.{releaseDate}.zip",
          "install": {
            "kind": "tool-install",
            "dest": "$toolsDir/MORT"
          },
          "constraints": {},
          "rank": 50
        }
      ],
      "versions": [
        {
          "version": "1.318",
          "tag": "1.318",
          "channel": "stable",
          "released": "2026-08-15",
          "asset": "MORT.1.318v.-.20260815.zip",
          "variants": [
            "standalone"
          ]
        }
      ],
      "notes": [
        "Ships its own embedded Python and tessdata; treat the whole folder as one unit and never merge versions."
      ]
    },
    {
      "id": "lunatranslator",
      "name": "LunaTranslator",
      "kind": "hook-and-ocr",
      "homepage": "https://github.com/HIllya51/LunaTranslator",
