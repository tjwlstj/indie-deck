{
  "$schema": "./schema/translators.schema.json",
  "schemaVersion": 1,
  "updated": "2026-08-21",
  "notes": "A translator has `variants` (which build of it) and `versions` (which release). A resolver picks one (variant, version, loader version) triple that satisfies the detected game profile. `assetTemplate` is expanded with {version}; `tag` is the GitHub release tag, which does not always equal the asset version (e.g. tag v5.6 ships assets named 5.6.0).",
  "translators": [
    {
      "id": "xunity-autotranslator",
      "name": "XUnity.AutoTranslator",
      "kind": "in-process-hook",
      "homepage": "https://github.com/bbepis/XUnity.AutoTranslator",
      "repo": "bbepis/XUnity.AutoTranslator",
      "license": "MIT",
      "engines": [
        "unity"
      ],
      "summary": "Hooks Unity text components at runtime and substitutes machine or cached translations. The de-facto standard for Unity game translation.",
      "endpoints": [
        {
          "id": "GoogleTranslate",
          "needsKey": false
        },
        {
          "id": "GoogleTranslateV2",
          "needsKey": false
        },
        {
          "id": "GoogleTranslateCompat",
          "needsKey": false
        },
        {
          "id": "GoogleTranslateLegitimate",
          "needsKey": true
        },
        {
          "id": "BingTranslate",
          "needsKey": false
        },
        {
          "id": "BingTranslateLegitimate",
          "needsKey": true
        },
        {
          "id": "DeepLTranslate",
          "needsKey": false
        },
        {
          "id": "DeepLTranslateLegitimate",
          "needsKey": true
        },
        {
          "id": "PapagoTranslate",
          "needsKey": false
        },
        {
          "id": "BaiduTranslate",
          "needsKey": true
        },
        {
          "id": "YandexTranslate",
          "needsKey": true
        },
        {
          "id": "WatsonTranslate",
          "needsKey": true
        },
        {
          "id": "LingoCloudTranslate",
          "needsKey": true
        },
        {
          "id": "ezTransXP",
          "needsKey": false,
          "note": "Local Korean MT engine; requires a local ezTrans XP installation."
        },
        {
          "id": "LecPowerTranslator15",
          "needsKey": false,
          "note": "Local MT engine."
        },
        {
          "id": "CustomTranslate",
          "needsKey": false,
          "note": "Points at any local HTTP endpoint - the usual way to wire in a self-hosted MT server."
        }
      ],
      "variants": [
        {
          "id": "bepinex",
          "name": "BepInEx (Mono)",
          "assetTemplate": "XUnity.AutoTranslator-BepInEx-{version}.zip",
          "requiresLoader": {
            "capability": "bepinex",
            "prefer": [
              "bepinex5",
              "bepinex6-mono"
            ]
          },
          "constraints": {
            "engine": [
              "unity"
            ],
            "backend": [
              "mono"
            ]
          },
          "install": {
            "kind": "extract-root"
          },
          "payloadPaths": [
            "BepInEx/core/XUnity.Common.dll",
            "BepInEx/plugins/XUnity.AutoTranslator"
          ],
          "configCandidates": [
            "BepInEx/config/AutoTranslatorConfig.ini"
          ],
          "configConfidence": "verified",
          "configNote": "Confirmed against real installs: BepInEx/config/AutoTranslatorConfig.ini, generated on first launch.",
          "recommendedFor": "Default choice for any Mono Unity game.",
          "rank": 100
        },
        {
          "id": "bepinex-il2cpp",
          "name": "BepInEx 6 (IL2CPP)",
          "assetTemplate": "XUnity.AutoTranslator-BepInEx-IL2CPP-{version}.zip",
          "requiresLoader": {
            "capability": "bepinex6-il2cpp",
            "prefer": [
              "bepinex6-il2cpp"
            ]
          },
          "constraints": {
            "engine": [
              "unity"
            ],
            "backend": [
              "il2cpp"
            ],
            "unityVersion": {
              "min": "2017.1.0",
              "confidence": "verified",
              "sources": [
                "https://github.com/bbepis/XUnity.AutoTranslator/blob/master/CHANGELOG.md"
              ],
              "note": "CHANGELOG 5.3.0: 'Dropped support for pre-2017 Unity Engine versions for IL2CPP versions'."
            }
          },
          "install": {
            "kind": "extract-root"
          },
          "payloadPaths": [
            "BepInEx/core/XUnity.Common.dll",
            "BepInEx/plugins/XUnity.AutoTranslator"
          ],
          "configCandidates": [
            "BepInEx/config/AutoTranslatorConfig.ini"
          ],
          "configConfidence": "verified",
          "recommendedFor": "IL2CPP games. README: 'you must install BepInEx 6 for IL2CPP, which as of this writing are only available as bleeding edge builds'.",
          "rank": 100
        },
        {
          "id": "melonmod",
          "name": "MelonLoader (Mono)",
          "assetTemplate": "XUnity.AutoTranslator-MelonMod-{version}.zip",
          "requiresLoader": {
            "capability": "melonloader",
            "prefer": [
              "melonloader"
            ]
          },
          "constraints": {
            "engine": [
              "unity"
            ],
            "backend": [
              "mono"
            ]
          },
          "install": {
            "kind": "extract-root"
          },
          "payloadPaths": [
            "Mods/XUnity.AutoTranslator.Plugin.MelonMod.dll",
            "UserLibs/XUnity.Common.dll"
          ],
          "configCandidates": [
            "UserData/AutoTranslatorConfig.ini"
          ],
          "configConfidence": "community",
          "recommendedFor": "Games already running MelonLoader - do not stack it on top of BepInEx.",
          "rank": 70
        },
        {
          "id": "melonmod-il2cpp",
          "name": "MelonLoader (IL2CPP)",
          "assetTemplate": "XUnity.AutoTranslator-MelonMod-IL2CPP-{version}.zip",
          "requiresLoader": {
            "capability": "melonloader",
            "prefer": [
              "melonloader"
            ]
          },
          "constraints": {
            "engine": [
              "unity"
            ],
            "backend": [
              "il2cpp"
            ],
            "unityVersion": {
              "min": "2017.1.0",
              "confidence": "verified",
              "sources": [
                "https://github.com/bbepis/XUnity.AutoTranslator/blob/master/CHANGELOG.md"
              ]
            }
          },
          "install": {
            "kind": "extract-root"
          },
          "payloadPaths": [
            "Mods/XUnity.AutoTranslator.Plugin.MelonMod.dll",
            "UserLibs/XUnity.Common.dll"
          ],
          "configCandidates": [
            "UserData/AutoTranslatorConfig.ini"
          ],
          "configConfidence": "community",
          "recommendedFor": "IL2CPP games where BepInEx 6 BE fails to boot.",
          "rank": 70,
          "payloadNote": "Both MelonMod packages ship the same DLL name; the installed variant is disambiguated by the game's scripting backend."
        },
        {
          "id": "reipatcher",
          "name": "ReiPatcher (standalone, no loader)",
          "assetTemplate": "XUnity.AutoTranslator-ReiPatcher-{version}.zip",
          "requiresLoader": {
            "capability": "reipatcher",
            "prefer": [
              "reipatcher"
            ],
            "bundled": true
          },
          "constraints": {
            "engine": [
              "unity"
            ],
            "backend": [
              "mono"
            ],
            "conflictsWithInstalled": [
              "bepinex",
              "melonloader",
              "unityinjector",
              "ipa"
            ]
          },
          "install": {
            "kind": "run-setup",
            "setupExe": "SetupReiPatcherAndAutoTranslator.exe",
            "launchShortcut": "{exeName} (Patch and Run).lnk"
          },
          "payloadPaths": [
            "ReiPatcher/ReiPatcher.exe",
            "SetupReiPatcherAndAutoTranslator.exe"
          ],
          "configCandidates": [
            "AutoTranslator/Config.ini",
            "Config.ini"
          ],
          "configConfidence": "community",
          "recommendedFor": "Old Mono games and anyone who wants zero loader setup. README: 'REQUIRES: Nothing, ReiPatcher is provided by this download.'",
          "warnings": [
            "Patches game assemblies in place - IndieDeck always snapshots Managed/ before running the setup."
          ],
          "rank": 60
        },
        {
          "id": "unityinjector",
          "name": "UnityInjector (Sybaris)",
          "assetTemplate": "XUnity.AutoTranslator-UnityInjector-{version}.zip",
          "requiresLoader": {
            "capability": "unityinjector",
            "prefer": []
          },
          "constraints": {
            "engine": [
              "unity"
            ],
            "backend": [
              "mono"
            ]
          },
          "install": {
            "kind": "extract-into",
            "dest": "UnityInjector"
          },
          "configCandidates": [
            "UnityInjector/Config/AutoTranslatorConfig.ini"
          ],
          "configConfidence": "community",
          "warnings": [
            "README: 'MonoMod hooks are not supported with this installation method because an outdated version of Mono.Cecil.dll is being used.'"
          ],
          "rank": 30,
          "payloadPaths": [
            "UnityInjector/XUnity.AutoTranslator.Plugin.Core.dll"
          ]
        },
        {
          "id": "ipa",
          "name": "IPA",
          "assetTemplate": "XUnity.AutoTranslator-IPA-{version}.zip",
          "requiresLoader": {
            "capability": "ipa",
            "prefer": []
          },
          "constraints": {
            "engine": [
              "unity"
            ],
            "backend": [
              "mono"
            ]
          },
          "install": {
            "kind": "extract-into",
            "dest": "Plugins"
          },
          "configCandidates": [
            "UserData/AutoTranslatorConfig.ini"
          ],
          "configConfidence": "community",
          "recommendedFor": "Games already using the IPA plugin manager (Beat Saber lineage).",
          "rank": 20,
          "payloadPaths": [
            "Plugins/XUnity.AutoTranslator.Plugin.Core.dll"
          ]
        }
      ],
      "versions": [
