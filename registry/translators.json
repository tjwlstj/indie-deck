    {
      "id": "mtool",
      "name": "MTool",
      "kind": "external-injector",
      "homepage": "https://afdian.com/a/AdventCirno",
      "license": "proprietary",
      "engines": [
        "rpgmaker-mv",
        "rpgmaker-mz",
        "rpgmaker-rgss",
        "wolf-rpg",
        "unity"
      ],
      "summary": "Closed-source RPG Maker translation/cheat tool. IndieDeck does not download or install it - it only detects an existing install so the library view stays honest.",
      "detectOnly": true,
      "installedMarkers": {
        "paths": [
          "MTool_Game.exe",
          "TrsData.bin"
