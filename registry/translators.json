          "assetPattern": ".*\\.(zip|7z)$",
          "constraints": {
            "engine": [
              "renpy"
            ]
          },
          "rank": 80
        }
      ],
      "versions": [
        {
          "version": "latest",
          "tag": "latest",
          "channel": "stable",
          "variants": [
            "release"
          ]
        }
      ],
      "notes": [
        "Works on decompiled .rpy sources; archived .rpa/.rpyc-only builds must be unpacked first (UnRen or rpatool)."
      ]
    },
    {
      "id": "projz-renpy-translation",
      "name": "projz_renpy_translation",
      "kind": "offline-file-patcher",
