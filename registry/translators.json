          "variants": [
            "zip"
          ]
        }
      ]
    },
    {
      "id": "renpy-translator",
      "name": "renpy-translator",
      "kind": "offline-file-patcher",
      "homepage": "https://github.com/anonymousException/renpy-translator",
      "repo": "anonymousException/renpy-translator",
      "license": "MIT",
      "engines": [
        "renpy"
      ],
      "summary": "Generates Ren'Py tl/ translation files offline (Google/Youdao/DeepL/OpenAI backends). Produces a real translation the game loads natively - no runtime hook.",
