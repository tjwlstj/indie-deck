      "provides": [
        "melonloader"
      ],
      "homepage": "https://github.com/LavaGang/MelonLoader",
      "license": "Apache-2.0",
      "engines": [
        "unity"
      ],
      "constraints": {
        "backend": [
          "mono",
          "il2cpp"
        ],
        "arch": [
          "x86",
          "x64"
        ],
        "unityVersion": {
          "min": "5.6.1",
          "confidence": "unverified",
          "sources": [
            "https://github.com/LavaGang/MelonLoader"
          ],
          "note": "The README does not state a Unity range. 5.6.1 is the commonly cited community minimum and has NOT been confirmed against primary docs - treated as a warning, never a hard block."
        },
        "runtime": {
          "dotnet": "6.0-desktop",
          "confidence": "verified",
          "sources": [
            "https://github.com/LavaGang/MelonLoader"
          ],
          "note": "README: Il2Cpp games require the .NET 6.0 Desktop Runtime (auto-installed on Windows)."
        }
      },
      "installedMarkers": {
        "paths": [
          "MelonLoader/net6/MelonLoader.dll",
          "MelonLoader/net35/MelonLoader.dll",
          "MelonLoader/MelonLoader.dll"
        ],
        "versionFrom": {
          "kind": "peFileVersion",
          "path": "MelonLoader/net6/MelonLoader.dll"
        },
        "note": "version.dll is deliberately not a marker: every proxy-DLL loader claims that filename."
      },
      "install": {
        "kind": "extract-root",
        "note": "README: extract the MelonLoader folder plus version.dll and dobby.dll into the game folder."
      },
      "uninstall": {
