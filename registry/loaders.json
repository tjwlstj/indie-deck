  "$schema": "./schema/loaders.schema.json",
  "schemaVersion": 1,
  "updated": "2026-08-21",
  "notes": "Mod loaders / plugin hosts. A translator variant may declare `requiresLoader`; the resolver then picks a loader version whose `provides` capability and constraints match the detected game profile. Every constraint carries a `confidence` and `sources` so the UI can distinguish verified facts from community lore.",
  "loaders": [
    {
      "id": "bepinex5",
      "name": "BepInEx 5",
      "provides": [
        "bepinex",
        "bepinex5"
      ],
      "homepage": "https://github.com/BepInEx/BepInEx",
      "license": "LGPL-2.1",
      "engines": [
        "unity"
      ],
      "constraints": {
        "backend": [
          "mono"
        ],
        "unityVersion": {
          "min": "3.0.0",
          "confidence": "verified",
          "sources": [
            "https://docs.bepinex.dev/articles/user_guide/installation/index.html"
          ],
          "note": "Docs: 'Unity 3 or newer'. Same docs: 'Games built with IL2CPP are not supported at the moment.'"
        },
        "arch": [
          "x86",
          "x64"
        ]
      },
      "installedMarkers": {
        "paths": [
          "BepInEx/core/BepInEx.dll"
        ],
        "excludeIfPresent": [
          "BepInEx/core/BepInEx.Core.dll"
        ],
        "versionFrom": {
          "kind": "peFileVersion",
          "path": "BepInEx/core/BepInEx.dll"
        },
        "note": "BepInEx 6 also ships a BepInEx.dll, so the 6-only BepInEx.Core.dll acts as a negative marker. Verified against real installs."
      },
      "install": {
        "kind": "extract-root",
        "note": "Extract archive contents into the game root, then launch once to generate BepInEx/config."
      },
      "uninstall": {
        "removePaths": [
          "BepInEx",
          "winhttp.dll",
          "doorstop_config.ini",
          ".doorstop_version"
