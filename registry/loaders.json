    {
      "id": "rpgmaker-plugins",
      "name": "RPG Maker MV/MZ plugin system (native)",
      "provides": [
        "rpgmaker-plugins"
      ],
      "engines": [
        "rpgmaker-mv",
        "rpgmaker-mz"
      ],
      "constraints": {
        "note": "No external loader needed: js/plugins/*.js plus an entry in js/plugins.js. IndieDeck edits plugins.js transactionally and keeps a backup."
      },
      "installedMarkers": {
        "paths": [
          "js/plugins.js",
          "www/js/plugins.js"
        ]
      },
      "install": {
        "kind": "native"
      },
      "versions": [],
      "modLayout": {
        "dir": "js/plugins",
        "altDir": "www/js/plugins",
        "entry": "js",
        "disable": "registry-flag",
