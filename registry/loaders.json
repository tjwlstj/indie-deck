        }
      },
      "install": {
        "kind": "extract-root",
        "note": "First launch generates interop assemblies under BepInEx/interop and can take several minutes."
      },
      "uninstall": {
        "removePaths": [
          "BepInEx",
          "winhttp.dll",
          "doorstop_config.ini",
